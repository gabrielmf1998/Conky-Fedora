[Unit]
Description=Conky Fedora panel
Documentation=https://github.com/gabrielmf1998/Conky-Fedora
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/conky -c %h/.config/conky/pride/pride.conf
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
